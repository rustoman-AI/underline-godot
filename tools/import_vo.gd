extends SceneTree

## Rebuilds data/vo/underline_vo.json from the voiceover script pack:
##   godot --headless --path . -s res://tools/import_vo.gd -- --src=C:/Users/V/Downloads
## Reads underline_vo.json from --src. Story paragraphs come from underline_vo_stories.md when it sits beside it,
## because the JSON keeps only the hard line wraps. Stage directions are dropped and em dashes rewritten,
## since the text doubles as on-screen subtitles.

const OUT := "res://data/vo/underline_vo.json"
const TYPES := {"stories": "story", "radio": "radio", "events": "event", "system": "system"}
const DASH := "\u0001"


func _init() -> void:
	var src := ""
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--src="):
			src = arg.substr(6)
	var pack = JSON.parse_string(FileAccess.get_file_as_string(src.path_join("underline_vo.json")))
	if not pack is Dictionary:
		push_error("No underline_vo.json under --src=%s" % src)
		quit(1)
		return
	var paragraphs := _story_paragraphs(src.path_join("underline_vo_stories.md"))
	var lines: Array = []
	for section in TYPES:
		var group = pack.get(section, {})
		if not group is Dictionary:
			continue
		for key in group:
			var e: Dictionary = group[key]
			var row := {"id": str(e.get("id", key)), "type": str(TYPES[section]), "trigger": str(e.get("trigger", ""))}
			match section:
				"stories":
					row.id = "%s_story" % key
					row.cast = str(key)
					row.name = str(e.get("name", ""))
				"radio":
					var title := str(e.get("title", ""))
					var mood := "neutral"
					var open := title.rfind("(")
					if open >= 0 and title.ends_with(")"):
						mood = title.substr(open + 1, title.length() - open - 2).strip_edges()
						title = title.substr(0, open).strip_edges()
					row.title = title
					row.mood = mood
				"events":
					row.event = str(row.id).trim_prefix("event_").trim_suffix("_resolve")
				"system":
					row.condition = str(row.id).trim_prefix("sys_")
			for lang in ["en", "ru"]:
				var text := str(e.get(lang, ""))
				var para_key := "%s:%s" % [key, lang]
				if section == "stories" and paragraphs.has(para_key):
					text = str(paragraphs[para_key])
				row[lang] = clean(text)
				row["audio_" + lang] = str(e.get("audio_" + lang, ""))
			lines.append(row)
	var out := {
		"_note": "Generated by tools/import_vo.gd from the VO script pack. Each line: id, type, trigger, en, ru, audio_en, audio_ru; stories add cast, radio adds mood, events add event, system lines add condition. A missing audio file falls back to text.",
		"lines": lines,
	}
	DirAccess.make_dir_recursive_absolute(OUT.get_base_dir())
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(JSON.stringify(out, "  ", false) + "\n")
	f.close()
	print("VO IMPORT OK %d lines -> %s" % [lines.size(), OUT])
	quit(0)


## "jonah:en" -> paragraphs joined by blank lines, from the quoted blocks under each "### id" heading.
func _story_paragraphs(md_path: String) -> Dictionary:
	var out := {}
	if not FileAccess.file_exists(md_path):
		return out
	var id := ""
	var lang := ""
	var paras: Array = []
	var current: Array = []
	for raw in FileAccess.get_file_as_string(md_path).split("\n"):
		var line := raw.strip_edges()
		if line.begins_with(">"):
			var body := line.substr(1).strip_edges()
			if body == "":
				if not current.is_empty():
					paras.append(" ".join(current))
					current = []
			else:
				current.append(body)
			continue
		if not current.is_empty():
			paras.append(" ".join(current))
			current = []
		if id != "" and lang != "" and not paras.is_empty():
			out["%s:%s" % [id, lang]] = "\n\n".join(paras)
			paras = []
		if line.begins_with("### "):
			id = line.substr(4).split(" ")[0]
			lang = ""
		elif line == "**EN:**":
			lang = "en"
		elif line == "**RU:**":
			lang = "ru"
	if not current.is_empty():
		paras.append(" ".join(current))
	if id != "" and lang != "" and not paras.is_empty():
		out["%s:%s" % [id, lang]] = "\n\n".join(paras)
	return out


static func clean(text: String) -> String:
	text = text.strip_edges()
	while text.ends_with("-"):
		text = text.trim_suffix("-").strip_edges()
	var direction := RegEx.create_from_string("\\s*\\*\\([^)]*\\)\\*")
	var dashes := RegEx.create_from_string("\\s*\u2014(\\s*\u2014)*\\s*")
	var after_stop := RegEx.create_from_string("([,:;.!?\u2026])" + DASH)
	var spaces := RegEx.create_from_string(" {2,}")
	var paras: Array = []
	for para in text.split("\n\n"):
		var p := para.replace("\n", " ")
		p = direction.sub(p, "", true)
		p = dashes.sub(p, DASH, true)
		p = after_stop.sub(p, "$1 ", true)
		if p.begins_with(DASH):
			p = p.substr(1)
		p = p.replace(DASH, ", ")
		p = spaces.sub(p, " ", true).replace(" ,", ",").replace(",,", ",").strip_edges()
		if p != "":
			paras.append(p)
	return "\n\n".join(paras)
