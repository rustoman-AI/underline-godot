extends SceneTree

## Builds data/vo/event_vo.json from an event VO pack (folder with index_event_vo.tsv and the mp3 files) and copies
## the mp3 files into assets/audio/vo/events/:
##   godot --headless --path . -s res://tools/import_event_vo.gd -- --src=C:/path/to/event_vo
## File names say what each line voices:
##   evt_<event>_body          the event card text           evt_<event>_after_<choice>  a follow-up's text by choice
##   chk_<check>_body          a check event's intro          chk_<check>_<option>_<success|fail>  its outcome
##   crunch_<leg>_body         a crunch bill's text           end_<reason>                the plain game-over title
## Each row keeps the exact recorded text as en/ru, so the game can tell whether a recording still says what the
## card says (Voice.event_show). A language with no file just stays silent.

const OUT := "res://data/vo/event_vo.json"
const AUDIO := "res://assets/audio/vo/events"
const CHECKS := "res://data/events_checks.json"


func _init() -> void:
	var src := ""
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--src="):
			src = arg.substr(6)
	var index := src.path_join("index_event_vo.tsv")
	if not FileAccess.file_exists(index):
		push_error("No index_event_vo.tsv under --src=%s" % src)
		quit(1)
		return
	var check_ids: Array = []
	var checks = JSON.parse_string(FileAccess.get_file_as_string(CHECKS))
	if checks is Dictionary:
		for ev in checks.get("events", []):
			check_ids.append(str(ev.get("id", "")))
	check_ids.sort_custom(func(a, b): return a.length() > b.length())
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(AUDIO))
	var rows := {}
	var order: Array = []
	var head: PackedStringArray = []
	var copied := 0
	var skipped: PackedStringArray = []
	for raw in FileAccess.get_file_as_string(index).split("\n"):
		var line := raw.strip_edges(false, true)
		if line == "":
			continue
		var cols := line.split("\t")
		if head.is_empty():
			head = cols
			continue
		var cell := func(name: String) -> String:
			var at := head.find(name)
			return str(cols[at]).strip_edges() if at >= 0 and at < cols.size() else ""
		var file: String = cell.call("filename")
		var lang: String = cell.call("language").to_lower()
		var stem := file.get_basename()
		if not ["en", "ru"].has(lang) or not stem.ends_with("_" + lang):
			skipped.append(file)
			continue
		var key := _key(stem.trim_suffix("_" + lang), check_ids)
		if key.is_empty():
			skipped.append(file)
			continue
		var from := src.path_join(file)
		if not FileAccess.file_exists(from):
			skipped.append(file)
			continue
		DirAccess.copy_absolute(from, ProjectSettings.globalize_path(AUDIO.path_join(file)))
		copied += 1
		var id := str(key.id)
		if not rows.has(id):
			rows[id] = {"id": id, "type": "event_show", "kind": key.kind, "event": key.event, "part": key.part,
				"speaker": cell.call("speaker"), "en": "", "ru": "", "audio_en": "", "audio_ru": ""}
			order.append(id)
		rows[id][lang] = cell.call("exact_text")
		rows[id]["audio_" + lang] = AUDIO.path_join(file)
	var lines: Array = []
	for id in order:
		lines.append(rows[id])
	var out := {
		"_note": "Generated by tools/import_event_vo.gd from index_event_vo.tsv. Type event_show: the line read when an event card, a check outcome, a crunch bill or a plain game over is shown. kind: event, check, crunch or end; part: body, after_<choice>, <option>_success, <option>_fail or the game-over reason. en/ru hold the exact recorded text; Voice.event_show plays a line only while it matches what the card shows.",
		"lines": lines,
	}
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(JSON.stringify(out, "  ", false) + "\n")
	f.close()
	for file in skipped:
		print("EVENT VO SKIPPED %s" % file)
	print("EVENT VO IMPORT OK %d lines, %d files -> %s" % [lines.size(), copied, OUT])
	quit(0)


## evt_lamps_next_after_fix -> {kind event, event lamps_next, part after_fix}; {} for a name it does not know.
func _key(stem: String, check_ids: Array) -> Dictionary:
	if stem.begins_with("evt_"):
		var rest := stem.trim_prefix("evt_")
		var at := rest.rfind("_after_")
		if at > 0:
			return {"id": stem, "kind": "event", "event": rest.substr(0, at), "part": rest.substr(at + 1)}
		if rest.ends_with("_body"):
			return {"id": stem, "kind": "event", "event": rest.trim_suffix("_body"), "part": "body"}
	elif stem.begins_with("chk_"):
		var rest := stem.trim_prefix("chk_")
		for check in check_ids:
			if rest.begins_with(str(check) + "_"):
				return {"id": stem, "kind": "check", "event": str(check), "part": rest.trim_prefix(str(check) + "_")}
	elif stem.begins_with("crunch_") and stem.ends_with("_body"):
		return {"id": stem, "kind": "crunch", "event": stem.trim_prefix("crunch_").trim_suffix("_body"), "part": "body"}
	elif stem.begins_with("end_"):
		return {"id": stem, "kind": "end", "event": "end", "part": stem.trim_prefix("end_")}
	return {}
