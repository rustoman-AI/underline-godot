extends SceneTree

## Builds data/vo/event_vo.json from an event VO pack (folder with one index .tsv and the mp3 files) and copies
## the mp3 files into assets/audio/vo/events/:
##   godot --headless --path . -s res://tools/import_event_vo.gd -- --src=C:/path/to/event_vo
## A pack updates the lines it carries and keeps the rest, so a re-record pack of a few takes can go on top of the
## full one. The spoken text comes from exact_text, or current_text_spoken in re-record packs.
## File names say what each line voices:
##   evt_<event>_body          the event card text           evt_<event>_after_<choice>  a follow-up's text by choice
##   dilemma_<event>_body      the same binding as evt_<event>_body (release dilemma cards)
##   chk_<check>_body          a check event's intro          chk_<check>_<option>_<success|fail>  its outcome
##   crunch_<leg>_body         a crunch bill's text           end_<reason>                the plain game-over title
##   evt_law_line_text_<law>   a creed line's permanent text  evt_mandate_<pick_body|missed>  mandate cards
##   evt_creed_<tip>_body      a creed fork tip              evt_rumor_<id>_body          a night-run rumor line
##   evt_judgment_<id>_body    an epilogue judgment          evt_verdict_<ending>_<creed>_body  a verdict
##   named_<birth|seasoned|death_<cause>>   a named-life line, placeholders left as recorded
##   obs_<id>                  an observatory line with no card in this build yet
##   evt_marked_crate_body / evt_tripwire_body   night-run encounter cards
## Each row keeps the exact recorded text as en/ru, so the game can tell whether a recording still says what the
## card says (Voice.event_show). A language with no file just stays silent. Placeholders ({name}, {a}, {room})
## stay in the text; exact-match compares them as written.

const OUT := "res://data/vo/event_vo.json"
const AUDIO := "res://assets/audio/vo/events"
const CHECKS := "res://data/events_checks.json"
## Night-run encounter cards. Their files use the evt_<id>_body spelling, but they are not catalog events.
const ENCOUNTERS := ["marked_crate", "tripwire"]


func _init() -> void:
	var src := ""
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--src="):
			src = arg.substr(6)
	var index := ""
	for file in DirAccess.get_files_at(src):
		if str(file).begins_with("index") and str(file).ends_with(".tsv"):
			index = src.path_join(str(file))
	if index == "":
		push_error("No index*.tsv under --src=%s" % src)
		quit(1)
		return
	var check_ids: Array = []
	var checks = JSON.parse_string(FileAccess.get_file_as_string(CHECKS))
	if checks is Dictionary:
		for ev in checks.get("events", []):
			check_ids.append(str(ev.get("id", "")))
	check_ids.sort_custom(func(a, b): return a.length() > b.length())
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(AUDIO))
	var rows := {}
	var order: Array = []
	var before = JSON.parse_string(FileAccess.get_file_as_string(OUT)) if FileAccess.file_exists(OUT) else null
	if before is Dictionary:
		for row in before.get("lines", []):
			rows[str(row.id)] = row
			order.append(str(row.id))
	var head: PackedStringArray = []
	var copied := 0
	var skipped: PackedStringArray = []
	for raw in FileAccess.get_file_as_string(index).split("\n"):
		var line := raw.strip_edges(false, true)
		if line == "":
			continue
		var cols := line.split("\t")
		if head.is_empty():
			head = cols
			continue
		var cell := func(name: String) -> String:
			var at := head.find(name)
			return _unquote(str(cols[at]).strip_edges()) if at >= 0 and at < cols.size() else ""
		var file: String = cell.call("filename")
		var lang: String = cell.call("language").to_lower()
		var stem := file.get_basename()
		if not ["en", "ru"].has(lang) or not stem.ends_with("_" + lang):
			skipped.append(file)
			continue
		var key := _key(stem.trim_suffix("_" + lang), check_ids)
		if key.is_empty():
			skipped.append(file)
			continue
		var from := src.path_join(file)
		if not FileAccess.file_exists(from):
			skipped.append(file)
			continue
		DirAccess.copy_absolute(from, ProjectSettings.globalize_path(AUDIO.path_join(file)))
		copied += 1
		var id := str(key.id)
		if not rows.has(id):
			var speaker := str(cell.call("speaker"))
			if speaker == "":
				speaker = "Narrator"
			rows[id] = {"id": id, "type": "event_show", "kind": key.kind, "event": key.event, "part": key.part,
				"speaker": speaker, "en": "", "ru": "", "audio_en": "", "audio_ru": ""}
			order.append(id)
		var spoken: String = cell.call("exact_text")
		if spoken == "":
			spoken = cell.call("current_text_spoken")
		rows[id][lang] = spoken
		rows[id]["audio_" + lang] = AUDIO.path_join(file)
	var lines: Array = []
	for id in order:
		lines.append(rows[id])
	var out := {
		"_note": "Generated by tools/import_event_vo.gd from the VO packs' index files, later packs over earlier ones.Type event_show: the line read when an event card, a check outcome, a crunch bill or a plain game over is shown. kind: event, check, crunch, end, law, mandate, creed, rumor, encounter, judgment, verdict, named or obs; part: body, after_<choice>, <option>_success, <option>_fail, line, a creed, or flavor. en/ru hold the exact recorded text, placeholders included; Voice.event_show plays a line only while it matches what the card shows.",
		"lines": lines,
	}
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(JSON.stringify(out, "  ", false) + "\n")
	f.close()
	for file in skipped:
		print("EVENT VO SKIPPED %s" % file)
	print("EVENT VO IMPORT OK %d lines, %d files -> %s" % [lines.size(), copied, OUT])
	quit(0)


## A spreadsheet-quoted cell ("say ""Floor"" twice") back to its text.
func _unquote(cell: String) -> String:
	if cell.length() >= 2 and cell.begins_with("\"") and cell.ends_with("\""):
		return cell.substr(1, cell.length() - 2).replace("\"\"", "\"")
	return cell


## evt_lamps_next_after_fix -> {kind event, event lamps_next, part after_fix}; {} for a name it does not know.
## dilemma_<event>_body is the same card reading as evt_<event>_body. The release pack names those files that way.
## named_* keeps {name}, {a} and {room} in the recorded text. obs_* is kept for a card this build does not show yet.
func _key(stem: String, check_ids: Array) -> Dictionary:
	if stem.begins_with("dilemma_") and stem.ends_with("_body"):
		return {"id": stem, "kind": "event", "event": stem.trim_prefix("dilemma_").trim_suffix("_body"), "part": "body"}
	if stem.begins_with("named_death_"):
		return {"id": stem, "kind": "named", "event": stem.trim_prefix("named_"), "part": "body"}
	if stem == "named_birth" or stem == "named_seasoned":
		return {"id": stem, "kind": "named", "event": stem.trim_prefix("named_"), "part": "body"}
	if stem == "obs_kit_whistle_flavor":
		return {"id": stem, "kind": "obs", "event": "kit_whistle", "part": "flavor"}
	if stem.begins_with("evt_"):
		var law := _law_key(stem)
		if not law.is_empty():
			return law
		if stem == "evt_mandate_missed":
			return {"id": stem, "kind": "mandate", "event": "missed", "part": "body"}
		if stem == "evt_mandate_pick_body":
			return {"id": stem, "kind": "mandate", "event": "pick", "part": "body"}
		if stem.begins_with("evt_creed_") and stem.ends_with("_tip_body"):
			return {"id": stem, "kind": "creed", "event": stem.trim_prefix("evt_creed_").trim_suffix("_body"), "part": "body"}
		if stem.begins_with("evt_rumor_") and stem.ends_with("_body"):
			return {"id": stem, "kind": "rumor", "event": stem.trim_prefix("evt_rumor_").trim_suffix("_body"), "part": "body"}
		if stem.begins_with("evt_judgment_") and stem.ends_with("_body"):
			return {"id": stem, "kind": "judgment", "event": stem.trim_prefix("evt_judgment_").trim_suffix("_body"), "part": "body"}
		var verdict := _verdict_key(stem)
		if not verdict.is_empty():
			return verdict
		var rest := stem.trim_prefix("evt_")
		var at := rest.rfind("_after_")
		if at > 0:
			return {"id": stem, "kind": "event", "event": rest.substr(0, at), "part": rest.substr(at + 1)}
		if rest.ends_with("_body"):
			var event_id := rest.trim_suffix("_body")
			if ENCOUNTERS.has(event_id):
				return {"id": stem, "kind": "encounter", "event": event_id, "part": "body"}
			return {"id": stem, "kind": "event", "event": event_id, "part": "body"}
	elif stem.begins_with("chk_"):
		var rest := stem.trim_prefix("chk_")
		for check in check_ids:
			if rest.begins_with(str(check) + "_"):
				return {"id": stem, "kind": "check", "event": str(check), "part": rest.trim_prefix(str(check) + "_")}
	elif stem.begins_with("crunch_") and stem.ends_with("_body"):
		return {"id": stem, "kind": "crunch", "event": stem.trim_prefix("crunch_").trim_suffix("_body"), "part": "body"}
	elif stem.begins_with("end_"):
		return {"id": stem, "kind": "end", "event": "end", "part": stem.trim_prefix("end_")}
	return {}


## evt_law_line_text_covenant and evt_law_line_text_everything_has_a_price_body both name the law id.
func _law_key(stem: String) -> Dictionary:
	if not stem.begins_with("evt_law_line_text_"):
		return {}
	var law := stem.trim_prefix("evt_law_line_text_")
	if law.ends_with("_body"):
		law = law.trim_suffix("_body")
	if law == "":
		return {}
	return {"id": stem, "kind": "law", "event": law, "part": "line"}


## evt_verdict_hope_watch_body -> ending hope, creed watch.
func _verdict_key(stem: String) -> Dictionary:
	if not stem.begins_with("evt_verdict_") or not stem.ends_with("_body"):
		return {}
	var rest := stem.trim_prefix("evt_verdict_").trim_suffix("_body")
	var at := rest.rfind("_")
	if at <= 0:
		return {}
	return {"id": stem, "kind": "verdict", "event": rest.substr(0, at), "part": rest.substr(at + 1)}
